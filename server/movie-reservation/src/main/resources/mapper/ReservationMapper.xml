<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper
	namespace="com.korea.movie_reservation.dao.ReservationDAO">

	<select id="findAll" resultType="ReservationVO">
		select * from reservation
	</select>

	<insert id="insert">
		insert into
		reservation(customer_name,movie_id,seat_number,ticket_count,reservation_status) values(
		#{customerName},
		#{movieId},
		#{seatNumber},
		#{ticketCount},
		#{reservationStatus}
		)
	</insert>

	<select id="findreservationById" resultType="ReservationVO">
		select * from reservation
		where reservation_id=#{Id}
	</select>

</mapper>







